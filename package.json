{
  "name": "graphql-overfetch",
  "version": "0.4.0",
  "description": "Detect GraphQL overfetching in React apps: find fields your components request but never read. Also finds dead queries, dead fragments, duplicate documents, unused Code Generator types, query complexity, and schema drift across Apollo Client, urql, Relay, and graphql-request.",
  "keywords": [
    "graphql",
    "graphql-overfetch",
    "overfetch",
    "overfetching",
    "static-analysis",
    "apollo",
    "apollo-client",
    "urql",
    "relay",
    "graphql-request",
    "graphql-code-generator",
    "codegen",
    "react",
    "nextjs",
    "cli",
    "dead-code",
    "dead-query",
    "unused-fields",
    "schema-drift",
    "graphql-cli"
  ],
  "license": "MIT",
  "author": "Pramod H",
  "homepage": "https://github.com/pramod-h/graphql-overfetch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pramod-h/graphql-overfetch.git"
  },
  "bugs": {
    "url": "https://github.com/pramod-h/graphql-overfetch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "graphql-overfetch": "dist/cli.js",
    "gqo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "graphql": "^16.9.0",
    "ora": "^5.4.1",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
